{
    "name": "enable-basic",
    "description": "Enable Macie with default settings — baseline enable, no scope exclusions (inventory needs time to populate); automatedDiscoveryEnabled omitted, so it must default to false (opt-in)",
    "order": 2,
    "moduleConfig": {
        "enable": true,
        "delegatedAdminAccount": "Audit",
        "boundary": {
            "regions": [
                "us-east-1",
                "eu-west-1"
            ]
        },
        "regionFilters": {
            "ignoredRegions": [
                "eu-west-1"
            ],
            "disabledRegions": []
        },
        "policyFindingsPublishingFrequency": "FIFTEEN_MINUTES",
        "publishSensitiveDataFindings": true,
        "publishPolicyFindings": true
    },
    "expectedAssertions": {
        "macieSessionEnabled": true,
        "delegatedAdminConfigured": true,
        "findingsPublishingConfigured": true,
        "publishingFrequency": "FIFTEEN_MINUTES",
        "regionIgnored": "eu-west-1",
        "automatedDiscoveryEnabled": false
    },
    "skipCleanup": true
}