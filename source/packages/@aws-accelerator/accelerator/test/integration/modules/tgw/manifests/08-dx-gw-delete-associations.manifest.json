            "staticRoutesOnly": true,
            "routeTableAssociations": ["segregated-rt"],
            "routeTablePropagations": ["core-rt"]
          }
        ]
      }
    ],
    "directConnectGateways": [
      { "name": "network-dxgw", "account": "Network", "asn": 64512, "transitGatewayAssociations": [] },
      { "name": "shared-dxgw", "account": "Shared Services", "asn": 64512, "transitGatewayAssociations": [] }
    ]
  },
  "expectedAssertions": {
    "moduleResponseStatus": "completed",
    "dxGatewayAssociationState": {
      "name": "network-dxgw",
      "account": "Network",
      "associationType": "direct",
      "state": "disassociated"
    },
    "stateTableEntry": {}
  },
  "skipCleanup": true
