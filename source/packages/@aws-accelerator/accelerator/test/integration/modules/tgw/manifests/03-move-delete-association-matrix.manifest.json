{
  "name": "move-delete-association-matrix",
  "description": "Move VPC and VPN associations together while deleting stale shared/template associations and propagations",
  "order": 3,
  "moduleConfig": {
    "homeRegion": "${ENV:TGW_INTEG_HOME_REGION}",
    "enabledRegions": ["${ENV:TGW_INTEG_HOME_REGION}"],
    "transitGateways": [
      {
        "name": "main-tgw",
        "account": "Network",
        "region": "${ENV:TGW_INTEG_HOME_REGION}",
        "asn": 64513,
        "dnsSupport": "enable",
        "vpnEcmpSupport": "enable",
        "defaultRouteTableAssociation": "disable",
        "defaultRouteTablePropagation": "disable",
        "autoAcceptSharingAttachments": "enable",
        "routeTables": [
          { "name": "core-rt", "routes": [] },
          { "name": "segregated-rt", "routes": [] }
        ],
        "shareTargets": { "organizationalUnits": [], "accounts": ["Shared Services"] }
      }
    ],
    "vpcs": [
      {
        "name": "network-vpc",
        "account": "Network",
        "region": "${ENV:TGW_INTEG_HOME_REGION}",
        "cidrs": ["10.100.0.0/16"],
        "transitGatewayAttachments": [
          {
            "name": "network-vpc-attach",
            "transitGateway": { "name": "main-tgw", "account": "Network" },
            "subnets": [],
            "options": { "applianceModeSupport": "disable", "dnsSupport": "enable", "ipv6Support": "disable" },
            "routeTableAssociations": ["segregated-rt"],
            "routeTablePropagations": ["segregated-rt"]
          }
        ]
      },
      {
        "name": "shared-vpc",
        "account": "Shared Services",
        "region": "${ENV:TGW_INTEG_HOME_REGION}",
        "cidrs": ["10.101.0.0/16"],
        "transitGatewayAttachments": [
          {
            "name": "shared-vpc-attach",
            "transitGateway": { "name": "main-tgw", "account": "Network" },
            "subnets": [],
            "options": { "applianceModeSupport": "disable", "dnsSupport": "enable", "ipv6Support": "disable" },
            "routeTableAssociations": [],
            "routeTablePropagations": []
          }
        ]
      }
    ],
    "vpcTemplates": [
      {
        "name": "template-vpc",
        "deploymentTargets": { "accounts": ["Network", "Shared Services"] },
        "region": "${ENV:TGW_INTEG_HOME_REGION}",
        "cidrs": ["10.200.0.0/16"],
        "transitGatewayAttachments": [
          {
            "name": "template-vpc-attach",
            "transitGateway": { "name": "main-tgw", "account": "Network" },
            "subnets": [],
            "options": { "applianceModeSupport": "disable", "dnsSupport": "enable", "ipv6Support": "disable" },
            "routeTableAssociations": [],
            "routeTablePropagations": []
          }
        ]
      }
    ],
    "customerGateways": [
      {
        "name": "network-cgw",
        "account": "Network",
        "region": "${ENV:TGW_INTEG_HOME_REGION}",
        "ipAddress": "203.0.113.12",
        "asn": 65000,
        "vpnConnections": [
          {
            "name": "network-vpn",
            "transitGateway": "main-tgw",
            "staticRoutesOnly": true,
            "routeTableAssociations": ["segregated-rt"],
            "routeTablePropagations": ["core-rt"]
          }
        ]
      }
    ]
  },
  "expectedAssertions": {
    "moduleResponseStatus": "completed",
    "tgwRouteTableAssociations": {
      "core-rt": [],
      "segregated-rt": ["network-vpc-attach", "network-vpn"]
    },
    "tgwRouteTablePropagations": {
      "core-rt": ["network-vpn"],
      "segregated-rt": ["network-vpc-attach"]
    },
    "stateTableLastConfigVpcAttachments": [
      {
        "vpcName": "network-vpc",
        "accountId": "${ENV:TGW_INTEG_NETWORK_ACCOUNT_ID}",
        "region": "${ENV:TGW_INTEG_HOME_REGION}",
        "transitGatewayName": "main-tgw",
        "routeTableAssociations": ["segregated-rt"],
        "routeTablePropagations": ["segregated-rt"]
      },
      {
        "vpcName": "shared-vpc",
        "accountId": "${ENV:TGW_INTEG_SHARED_SERVICES_ACCOUNT_ID}",
        "region": "${ENV:TGW_INTEG_HOME_REGION}",
        "transitGatewayName": "main-tgw",
        "routeTableAssociations": [],
        "routeTablePropagations": []
      },
      {
        "vpcName": "template-vpc",
        "accountId": "${ENV:TGW_INTEG_NETWORK_ACCOUNT_ID}",
        "region": "${ENV:TGW_INTEG_HOME_REGION}",
        "transitGatewayName": "main-tgw",
        "routeTableAssociations": [],
        "routeTablePropagations": []
      },
      {
        "vpcName": "template-vpc",
        "accountId": "${ENV:TGW_INTEG_SHARED_SERVICES_ACCOUNT_ID}",
        "region": "${ENV:TGW_INTEG_HOME_REGION}",
        "transitGatewayName": "main-tgw",
        "routeTableAssociations": [],
        "routeTablePropagations": []
      }
    ],
    "stateTableEntry": {}
  },
  "skipCleanup": true
}
