{
  "name": "update-and-remove-owned-tags",
  "description": "Update a managed tag, add another, and remove a previously owned dynamic tag",
  "order": 3,
  "moduleConfig": {
    "account": "Shared Services",
    "region": "${ENV:CONFIG_RULE_TAGGING_INTEG_REGION}",
    "globalTags": [
      { "key": "StaticTag", "value": "updated-static" },
      { "key": "UpdatedTag", "value": "added-value" }
    ],
    "rules": [{ "name": "${ENV:CONFIG_RULE_TAGGING_INTEG_RULE_NAME}", "tags": [] }]
  },
  "expectedAssertions": {
    "moduleResponseStatus": "success",
    "configRuleResults": [
      {
        "account": "Shared Services",
        "region": "${ENV:CONFIG_RULE_TAGGING_INTEG_REGION}",
        "ruleName": "${ENV:CONFIG_RULE_TAGGING_INTEG_RULE_NAME}",
        "status": "tagged",
        "changedTagKeys": ["StaticTag", "UpdatedTag"],
        "removedTagKeys": ["DynamicTag"],
        "unmanagedTagKeys": ["ExternalSentinel", "${ENV:CONFIG_RULE_TAGGING_INTEG_OWNERSHIP_TAG_KEY}"]
      }
    ],
    "configRuleTags": [
      {
        "account": "Shared Services",
        "region": "${ENV:CONFIG_RULE_TAGGING_INTEG_REGION}",
        "ruleName": "${ENV:CONFIG_RULE_TAGGING_INTEG_RULE_NAME}",
        "tags": {
          "Accelerator": "${ENV:ACCELERATOR_PREFIX}",
          "ExternalSentinel": "preserved",
          "${ENV:CONFIG_RULE_TAGGING_INTEG_OWNERSHIP_TAG_KEY}": "${ENV:CONFIG_RULE_TAGGING_INTEG_OWNERSHIP_TAG_VALUE}",
          "StaticTag": "updated-static",
          "UpdatedTag": "added-value"
        },
        "absentTagKeys": ["DynamicTag"]
      }
    ],
    "stateOwnedTagKeys": [
      {
        "account": "Shared Services",
        "region": "${ENV:CONFIG_RULE_TAGGING_INTEG_REGION}",
        "ruleName": "${ENV:CONFIG_RULE_TAGGING_INTEG_RULE_NAME}",
        "tagKeys": ["Accelerator", "StaticTag", "UpdatedTag"]
      }
    ],
    "stateTableEntry": { "status": "success" }
  },
  "skipCleanup": true
}
